            {
              "id": "e0374bce-4287-455a-986e-95f6fffec125",
              "name": "rejectionReason",
              "value": "={{ 'Missing or invalid: ' + [!$json.customerName ? 'name' : '', !$json.customerEmail ? 'email' : (/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test($json.customerEmail) ? '' : 'email (invalid format)'), !$json.subject ? 'subject' : '', !$json.priority ? 'priority' : ''].filter(Boolean).join(', ') }}",
              "type": "string"
            },
            {
              "id": "c388b7a9-3967-4272-ac76-916eebcd21c9",
