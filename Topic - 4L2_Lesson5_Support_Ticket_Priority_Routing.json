            {
              "id": "ff3fc892-acbf-45ac-aee9-3e57a9b17db2",
              "name": "notificationSubject",
              "value": "={{ $json.priority === 'urgent' ? '[URGENT ESCALATION] Support Ticket: ' + $json.subject : (['low','medium','high'].includes($json.priority) ? '[' + $json.priority.toUpperCase() + '] Support Ticket: ' + $json.subject : '[UNRECOGNIZED PRIORITY: ' + $json.originalPriority + '] Support Ticket: ' + $json.subject) }}",
              "type": "string"
            },
            {
              "id": "51865625-0e19-4836-b0c3-bc8373dd7dd3",
              "name": "notificationBody",
              "value": "={{ (['low','medium','high','urgent'].includes($json.priority) ? '' : 'MANUAL REVIEW REQUIRED - unrecognized priority value.\\n\\n') + ($json.priority === 'urgent' ? 'URGENT ESCALATION - immediate on-call attention required.\\n\\n' : '') + 'Customer: ' + $json.customerName + '\\nCustomer Email: ' + $json.customerEmail + '\\nPriority: ' + (['low','medium','high','urgent'].includes($json.priority) ? $json.priority.toUpperCase() : 'UNRECOGNIZED (' + $json.originalPriority + ')') + '\\nSubject: ' + $json.subject + '\\nIssue Description: ' + ($json.description || 'Not provided') }}",
              "type": "string"
            },
            {
              "id": "c5f51580-d992-497b-a307-b6b76cd8bad9",
              "name": "routingTeam",
              "value": "={{ ({low:'General Support', medium:'Tier 1 Support', high:'Tier 2 Support', urgent:'On-Call Escalation'})[$json.priority] || 'General Support Queue' }}",
              "type": "string"
            },
            {
              "id": "4f8d8603-efa2-400e-b565-48068aeedbbc",
