        192
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const lead = item.json;\n  return {\n    json: {\n      id: lead.id,\n      name: lead.normalizedName,\n      email: lead.cleanedEmail,\n      phone: lead.cleanedPhone,\n      status: lead.status,\n      originalEmail: lead.email\n    }\n  };\n});"
      },
