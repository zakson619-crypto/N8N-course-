    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const lead = item.json;\n  const normalizedName = (lead.fullName ?? \"\").trim().replace(/\\s+/g, \" \");\n  const cleanedEmail = (lead.email ?? \"\").trim().toLowerCase();\n  const cleanedPhone = (lead.phone ?? \"\").replace(/\\D/g, \"\");\n  return {\n    json: {\n      ...lead,\n      normalizedName,\n      cleanedEmail,\n      cleanedPhone,\n      status: lead.status ?? \"New\"\n    }\n  };\n});"
      },
      "id": "f07ca489-6a56-4353-aba1-12d41553e678",
